{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug launch",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=quark",
          "--package=quark"
        ],
        "filter": {
          "name": "quark",
          "kind": "bin"
        }
      },
      "args": [
        "-i",
        "${workspaceFolder}/tests/lexer/inputs/prototype.qk",
        "-o",
        "${workspaceFolder}/out"
      ],
      "cwd": "${workspaceFolder}",
      "postDebugTask": "",
      "postRunCommands": []
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/aaron/git/quark",
      "program": "/home/aaron/git/quark/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}